# 이 파일을 복사해 .env로 만들고 실제 값을 채우세요. .env는 git에 커밋하지 않습니다.
# cp .env.example .env

# --- Claude / Agent SDK ---
ANTHROPIC_API_KEY=

# --- DART OpenAPI (공시/재무 조회) ---
DART_API_KEY=

# --- Postgres (docker-compose 기본값과 일치) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
DATABASE_URL=postgresql://app:app@postgres:5432/app

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
