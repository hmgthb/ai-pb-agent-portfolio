# 이 파일을 복사해 .env로 만들고 실제 값을 채우세요. .env는 git에 커밋하지 않습니다.
# cp .env.example .env

# --- Claude / Agent SDK ---
ANTHROPIC_API_KEY=

# --- DART OpenAPI (공시/재무 조회) ---
DART_API_KEY=

# --- 네이버 검색 오픈API (뉴스 조회, A4) ---
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- 공공데이터포털 (KRX 지연시세 · 지수, F2 브리핑) ---
# data.go.kr 가입 → "금융위원회_주식시세정보" 활용신청 → 일반 인증키(Decoding) 사용
# ⚠️ 지수(코스피·코스닥)는 **서비스가 따로다** — "금융위원회_지수시세정보"도 활용신청해야
#    브리핑 거시 띠에 지수가 뜬다(개발계정 자동승인). 미신청이면 403이고, 화면은 조용히
#    비지 않고 "미연결"이라고 말한다.
KRX_API_KEY=

# --- 한국은행 ECOS (F2 브리핑 거시 띠의 환율·금리) ---
# ecos.bok.or.kr 가입 → 인증키 신청(즉시 발급). 없으면 브리핑은 그대로 돌고 환율·금리
# 자리만 "미연결"로 뜬다 — 지수와 같은 규약이다(backend/ecos.py).
# ⚠️ 공개 `sample` 키는 호출당 10건 제한이라 창을 못 채운다. 검증용이지 운영용이 아니다.
ECOS_API_KEY=

# --- Postgres (docker-compose 기본값과 일치) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
DATABASE_URL=postgresql://app:app@postgres:5432/app

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
